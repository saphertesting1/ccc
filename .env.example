# =========================================================================
# CHANDU CHICKEN CENTER — ENVIRONMENT VARIABLES SPECIFICATION
# Note: Do not commit secrets. Copy to .env for local configuration.
# =========================================================================

# Node server port (default: 3000)
PORT=3000

# Base URL of application
APP_URL="https://your-domain.com"

# Relational Database Configuration (PostgreSQL)
# If provided, the app connects to PostgreSQL.
# If omitted or empty, the app seamlessly defaults to the zero-config persistent file store in /data.
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/chandu_chicken_db"

# Image Storage Service Provider: "local" | "s3" | "cloudinary" (default: "local")
IMAGE_STORAGE_PROVIDER="local"

# AWS S3 Configuration (Optional, when IMAGE_STORAGE_PROVIDER=s3)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="chandu-chicken-assets"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Cloudinary Configuration (Optional, when IMAGE_STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Future UPI Payment Gateway Provider: "pending_upi" | "phonepe" | "razorpay" | "cashfree"
# Default for Current Phase: "pending_upi"
PAYMENT_GATEWAY_PROVIDER="pending_upi"

# Optional Gemini API Key (if AI Studio injected)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
